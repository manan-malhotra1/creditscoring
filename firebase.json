{
  "hosting": {
    "target": "credit-console",
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/v2{,/**}",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/v1{,/**}",
        "destination": "/",
        "type": 301
      }
    ]
  }
}
